# ProcureFind settings. Copy to .env (never committed) and fill in.

# Demo build: no sign-in. Searches, choices and RFQs are recorded under this name.
DEMO_USER=Demo
# Optional: random string for the short-lived page messages; a temporary one is used if empty.
SECRET_KEY=

# AI server. "mock" = practice mode (no AI server, rule-based summaries).
# Office network: http://192.168.95.6:11434
LLM_BASE_URL=mock
LLM_MODEL=qwen3:8b
LLM_TIMEOUT=300

# Where supplier prices come from: live (real websites) or fixtures (saved pages, no internet).
# Defaults to fixtures in practice mode and live otherwise.
#SUPPLIER_SOURCE=live

# Optional contact address shown to supplier sites in the User-Agent.
CONTACT_EMAIL=

VAT_RATE=0.16

# Tier 2/3 suppliers: found near the search location on OpenStreetMap (DEFAULT_LOCATION when blank).
DEFAULT_LOCATION=Nairobi
DISCOVERY_DAYS=7            # refresh the nearby-supplier directory this often
SITE_CHECK_DAYS=7           # re-check a supplier's website this often
MAX_NEW_SITE_CHECKS=4       # unchecked supplier websites checked per search
#OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
CACHE_MINUTES=60
FETCH_TIMEOUT=15

HOST=127.0.0.1
PORT=8090
